# Disalin otomatis ke config/server.env saat pertama kali dijalankan.
# $SERVER_DIR terisi otomatis (folder server/ di HP).

# Port web Filebrowser (hindari < 1024 tanpa root)
FB_PORT=8080

# 0.0.0.0 = bisa diakses dari LAN / Tailscale
FB_ADDRESS=0.0.0.0

# Folder yang dijadikan cloud (butuh termux-setup-storage)
FB_ROOT="$HOME/storage/shared/CloudStorage"

# Database & log Filebrowser
FB_DB="$SERVER_DIR/data/filebrowser.db"
FB_LOG="$SERVER_DIR/data/filebrowser.log"

# Log dirotasi saat server start jika melebihi ukuran ini (KB)
FB_LOG_MAX_KB=2048
