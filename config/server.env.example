# Port web interface Filebrowser (hindari port < 1024 tanpa root di Termux)
FB_PORT=8080

# Alamat bind (0.0.0.0 agar bisa diakses dari perangkat lain di jaringan / Tailscale)
FB_ADDRESS=0.0.0.0

# Folder storage yang ingin dijadikan cloud (pastikan sudah jalankan termux-setup-storage)
FB_ROOT="$HOME/storage/shared/CloudStorage"

# Lokasi database & log Filebrowser
FB_DB="$HOME/termux-cloud-server/filebrowser.db"
FB_LOG="$HOME/termux-cloud-server/filebrowser.log"
