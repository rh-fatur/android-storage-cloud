#!/usr/bin/env bash
# cloudctl (ADMIN) - dijalankan di HP admin (Termux). Juga jalan di Linux/macOS/WSL.
# Mengendalikan HP cloud lewat SSH. Tidak ada layanan cloud yang jalan di sini.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ADMIN_DIR="$(dirname "$SELF")"
REPO_DIR="$(dirname "$ADMIN_DIR")"
SERVER_SRC="$REPO_DIR/server"
CONF="$ADMIN_DIR/config/admin.env"
RUN_DIR="$ADMIN_DIR/run"
ASSUME_YES=0

die()   { printf 'Error: %s\n' "$*" >&2; exit 1; }
have()  { command -v "$1" >/dev/null 2>&1; }
ok()    { printf '  [OK]      %s\n' "$*"; }
fail()  { printf '  [GAGAL]   %s\n' "$*"; }
note()  { printf '  [CATATAN] %s\n' "$*"; }

confirm() { # confirm <pertanyaan>; otomatis ya bila ada -y
  [ "$ASSUME_YES" = 1 ] && return 0
  local a; read -r -p "$1 [y/N] " a
  [ "$a" = y ] || [ "$a" = Y ]
}

# Path relatif yang aman di dalam folder cloud (tanpa .., tanpa awalan /)
safe_rel() {
  case "$1" in ""|.|./|/|/*|..|../*|*/..|*/../*) return 1 ;; esac
}

# ---------- konfigurasi & koneksi ----------
load_conf() {
  [ -f "$CONF" ] || die "Belum dikonfigurasi. Jalankan: cloud init"
  # shellcheck disable=SC1090
  . "$CONF"
  CLOUD_HOST_ALT="${CLOUD_HOST_ALT:-}"
  SSH_PORT="${SSH_PORT:-8022}"
  SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_ed25519_cloud}"
  REMOTE_DIR="${REMOTE_DIR:-cloud-server}"
  REMOTE_ROOT="${REMOTE_ROOT:-storage/shared/CloudStorage}"
  [ -n "${CLOUD_HOST:-}" ] && [ -n "${CLOUD_USER:-}" ] || die "CLOUD_HOST/CLOUD_USER kosong di $CONF"

  COMMON=(-i "$SSH_KEY" -o IdentitiesOnly=yes -o ConnectTimeout=8 -o ServerAliveInterval=15 -o StrictHostKeyChecking=accept-new)
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) ;;  # ControlMaster tidak didukung di Windows
    *) mkdir -p "$HOME/.ssh"
       COMMON+=(-o ControlMaster=auto -o ControlPersist=60 -o "ControlPath=$HOME/.ssh/cm-cloud-%C") ;;
  esac
}

tcp_ok() { # tcp_ok <host> <port>
  if have timeout; then timeout 5 bash -c "exec 3<>/dev/tcp/$1/$2" 2>/dev/null
  else bash -c "exec 3<>/dev/tcp/$1/$2" 2>/dev/null; fi
}

# Pilih alamat yang menjawab: utama dulu, lalu cadangan.
reach_host() {
  ACTIVE_HOST=""
  local h
  for h in "$CLOUD_HOST" "$CLOUD_HOST_ALT"; do
    [ -n "$h" ] || continue
    if tcp_ok "$h" "$SSH_PORT"; then ACTIVE_HOST="$h"; break; fi
  done
  [ -n "$ACTIVE_HOST" ] || return 1
  TARGET="$CLOUD_USER@$ACTIVE_HOST"
}

connect() {
  reach_host || die "HP cloud tidak terjangkau ($CLOUD_HOST${CLOUD_HOST_ALT:+ / $CLOUD_HOST_ALT}, port $SSH_PORT). Jalankan: cloud doctor"
}

remote_sh() { ssh "${COMMON[@]}" -p "$SSH_PORT" "$TARGET" "$@"; }

# Perintah 'cloudctl <args>' milik server, dengan pesan jelas bila belum di-deploy.
rcmd() {
  printf '[ -f "$HOME/%s/cloudctl" ] || { echo "Skrip server belum terpasang. Jalankan: cloud deploy" >&2; exit 3; }; bash "$HOME/%s/cloudctl" %s' \
    "$REMOTE_DIR" "$REMOTE_DIR" "$(printf '%q ' "$@")"
}
rc()     { remote_sh "$(rcmd "$@")"; }
rc_tty() { ssh -t "${COMMON[@]}" -p "$SSH_PORT" "$TARGET" "$(rcmd "$@")"; }

key_login_ok() { ssh "${COMMON[@]}" -o BatchMode=yes -p "$SSH_PORT" "$TARGET" true 2>/dev/null; }

# ---------- pairing ----------
# init                     -> interaktif
# init <ip> <user> [port]  -> tanpa tanya
cmd_init() {
  local host="${1:-}" user="${2:-}" port="${3:-8022}" alt="" key a
  if [ $# -eq 0 ]; then
    if [ -f "$CONF" ]; then read -r -p "admin.env sudah ada. Timpa? [y/N] " a; [ "$a" = y ] || exit 0; fi
    read -r -p "IP HP cloud (lihat 'cloudctl status' di sana): " host
    read -r -p "Username Termux HP cloud (jalankan 'whoami' di sana): " user
    read -r -p "Port SSH [8022]: " port; port="${port:-8022}"
    read -r -p "IP cadangan, mis. Tailscale (Enter untuk lewati): " alt
  fi
  [ -n "$host" ] && [ -n "$user" ] || die "Pemakaian: cloud init [ip user [port]]"
  key="$HOME/.ssh/id_ed25519_cloud"

  tcp_ok "$host" "$port" || die "Tidak bisa terhubung ke $host:$port. Di HP cloud pastikan sshd jalan (ketik: sshd), satu Wi-Fi, dan IP benar."

  mkdir -p "$HOME/.ssh"
  [ -f "$key" ] || ssh-keygen -t ed25519 -f "$key" -N "" -C "cloud-admin@$(uname -n)"

  echo "Memasang kunci publik di HP cloud (masukkan password SSH Termux-nya sekali)..."
  ssh -o StrictHostKeyChecking=accept-new -p "$port" "$user@$host" \
    'mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && k="$(cat)" && { grep -qxF "$k" ~/.ssh/authorized_keys || printf "%s\n" "$k" >> ~/.ssh/authorized_keys; }' < "$key.pub"

  sed -e "s|^CLOUD_HOST=.*|CLOUD_HOST=$host|" \
      -e "s|^CLOUD_HOST_ALT=.*|CLOUD_HOST_ALT=$alt|" \
      -e "s|^CLOUD_USER=.*|CLOUD_USER=$user|" \
      -e "s|^SSH_PORT=.*|SSH_PORT=$port|" \
      "$ADMIN_DIR/config/admin.env.example" > "$CONF"

  load_conf; connect
  key_login_ok || die "Login dengan kunci belum berfungsi. Jalankan: cloud doctor"
  echo "Login dengan kunci: OK"
  echo "Selesai. Berikutnya: cloud setup"
}

# set <KUNCI> <nilai>
cmd_set() {
  [ $# -eq 2 ] || die "Pemakaian: cloud set <CLOUD_HOST|CLOUD_HOST_ALT|CLOUD_USER|SSH_PORT> <nilai>"
  case "$1" in CLOUD_HOST|CLOUD_HOST_ALT|CLOUD_USER|SSH_PORT) ;; *) die "Kunci tidak dikenal: $1" ;; esac
  case "$2" in *[!A-Za-z0-9._:-]*) die "Nilai hanya boleh huruf, angka, titik, titik dua, minus." ;; esac
  if grep -q "^$1=" "$CONF"; then
    sed -i.bak "s|^$1=.*|$1=$2|" "$CONF" && rm -f "$CONF.bak"
  else
    printf '%s=%s\n' "$1" "$2" >> "$CONF"
  fi
  echo "$1 = $2"
}

# Info koneksi untuk aplikasi SFTP lain (HP admin yang tidak memakai Termux)
cmd_info() {
  load_conf
  echo "Host utama   : $CLOUD_HOST"
  [ -n "$CLOUD_HOST_ALT" ] && echo "Host cadangan: $CLOUD_HOST_ALT"
  echo "Port         : $SSH_PORT"
  echo "User         : $CLOUD_USER"
  echo "Folder cloud : ~/$REMOTE_ROOT  (folder awal SFTP adalah home Termux)"
  echo "Kunci privat : $SSH_KEY"
  echo
  echo "SSH   : ssh -p $SSH_PORT -i $SSH_KEY $CLOUD_USER@$CLOUD_HOST"
  echo "Catatan: aplikasi SFTP lain (Termius, dll) butuh password SSH atau kunci di atas."
  echo "         Setelah 'cloud ssh-harden', login password dimatikan, jadi hanya kunci yang diterima."
}

# ---------- mengatur HP cloud ----------
cmd_deploy() {
  [ -x "$SERVER_SRC/cloudctl" ] || die "Folder server/ tidak ditemukan di $SERVER_SRC"
  echo "Mengirim server/ ke $TARGET:~/$REMOTE_DIR ..."
  COPYFILE_DISABLE=1 tar -C "$SERVER_SRC" -cf - cloudctl \
    | remote_sh "mkdir -p \"\$HOME/$REMOTE_DIR\" && tar -C \"\$HOME/$REMOTE_DIR\" -xf - && chmod +x \"\$HOME/$REMOTE_DIR/cloudctl\""
  echo "Deploy selesai (config/server.env & data di HP cloud tidak disentuh)."
}

cmd_upgrade() {
  have git && [ -d "$REPO_DIR/.git" ] || die "$REPO_DIR bukan repo git."
  git -C "$REPO_DIR" pull --ff-only
  cmd_deploy
  echo "Jika ada perubahan pada watchdog/server, jalankan: cloud restart"
}

cmd_stop() {
  echo "Peringatan: sshd HP cloud akan berhenti, dan Anda tidak bisa mengendalikannya lagi dari sini."
  echo "Menyalakannya kembali harus dilakukan langsung di HP cloud."
  confirm "Tetap hentikan?" || { echo "Dibatalkan."; return 0; }
  rc stop
}

cmd_harden() {
  key_login_ok || die "Login dengan kunci belum berfungsi, jadi ssh-harden bisa mengunci Anda di luar. Jalankan: cloud init"
  echo "Login password SSH akan dimatikan. Hanya kunci $SSH_KEY yang diterima."
  echo "Aplikasi SFTP lain yang memakai password tidak bisa masuk lagi."
  confirm "Lanjutkan?" || { echo "Dibatalkan."; return 0; }
  rc ssh-harden
}

# ---------- file di cloud ----------
default_dl() { if [ -d "$HOME/storage/downloads" ]; then echo "$HOME/storage/downloads"; else echo "."; fi; }

# rsync (bisa dilanjutkan bila putus) bila ada di kedua HP, kalau tidak pakai scp
use_rsync() { have rsync && remote_sh "command -v rsync >/dev/null 2>&1"; }
rsh_cmd()   { printf 'ssh -p %s %s' "$SSH_PORT" "${COMMON[*]}"; }

cmd_ls() {
  local p="${1:-}"
  [ -z "$p" ] || safe_rel "$p" || die "Path tidak aman: $p"
  remote_sh "ls -lAh -- \"\$HOME/$REMOTE_ROOT/\"$(printf '%q' "$p")"
}

cmd_mkdir() {
  [ $# -ge 1 ] || die "Pemakaian: mkdir <folder-di-cloud>"
  safe_rel "$1" || die "Path tidak aman: $1"
  remote_sh "mkdir -p -- \"\$HOME/$REMOTE_ROOT/\"$(printf '%q' "$1")"
  echo "Folder dibuat: $1"
}

cmd_rm() {
  [ $# -ge 1 ] || die "Pemakaian: rm <path-di-cloud>... (tambah -y untuk melewati konfirmasi)"
  local p
  for p in "$@"; do safe_rel "$p" || die "Path tidak aman: '$p' (pakai path relatif di dalam folder cloud)"; done
  echo "Akan menghapus PERMANEN dari cloud:"
  printf '  %s\n' "$@"
  confirm "Lanjutkan?" || { echo "Dibatalkan."; return 0; }
  for p in "$@"; do remote_sh "rm -rf -- \"\$HOME/$REMOTE_ROOT/\"$(printf '%q' "$p")"; done
  echo "Selesai."
}

cmd_push() {
  [ $# -ge 1 ] || die "Pemakaian: push <file/folder-lokal> [folder-tujuan-di-cloud]"
  local src="$1" dest="${2:-}"
  [ -e "$src" ] || die "Tidak ditemukan: $src"
  [ -z "$dest" ] || safe_rel "$dest" || die "Path tujuan tidak aman: $dest"
  remote_sh "mkdir -p -- \"\$HOME/$REMOTE_ROOT/\"$(printf '%q' "$dest")"
  if use_rsync; then
    rsync -ah --partial --info=progress2 -s -e "$(rsh_cmd)" -- "$src" "$TARGET:$REMOTE_ROOT/$dest/"
  else
    scp -r "${COMMON[@]}" -P "$SSH_PORT" "$src" "$TARGET:$REMOTE_ROOT/$dest/"
  fi
  echo "Terkirim ke cloud: /${dest}"
}

cmd_pull() {
  [ $# -ge 1 ] || die "Pemakaian: pull <path-di-cloud> [folder-lokal]"
  safe_rel "$1" || die "Path tidak aman: $1"
  local dest="${2:-$(default_dl)}"
  mkdir -p "$dest"
  if use_rsync; then
    rsync -ah --partial --info=progress2 -s -e "$(rsh_cmd)" -- "$TARGET:$REMOTE_ROOT/$1" "$dest/"
  else
    scp -r "${COMMON[@]}" -P "$SSH_PORT" "$TARGET:$REMOTE_ROOT/$1" "$dest"
  fi
  echo "Tersimpan di: $dest"
}

# ---------- diagnosa ----------
cmd_doctor() {
  local bad=0 line
  echo "Diagnosa HP admin -> HP cloud"
  if [ -f "$CONF" ]; then ok "Konfigurasi: $CONF"; else fail "Belum ada konfigurasi. Jalankan: cloud init"; return 1; fi
  load_conf
  if [ -f "$SSH_KEY" ]; then ok "Kunci SSH: $SSH_KEY"; else fail "Kunci SSH tidak ada. Jalankan: cloud init"; return 1; fi

  if reach_host; then
    ok "HP cloud menjawab di $ACTIVE_HOST:$SSH_PORT"
  else
    fail "HP cloud tidak menjawab di $CLOUD_HOST${CLOUD_HOST_ALT:+ maupun $CLOUD_HOST_ALT} (port $SSH_PORT)"
    echo "           Cek di HP cloud: layar/Termux hidup? 'sshd' jalan? Wi-Fi sama? IP berubah?"
    echo "           Ubah alamat dengan: cloud set CLOUD_HOST <ip-baru>"
    return 1
  fi

  if key_login_ok; then ok "Login SSH dengan kunci"; else fail "Kunci ditolak HP cloud. Jalankan: cloud init"; return 1; fi

  if remote_sh "[ -f \"\$HOME/$REMOTE_DIR/cloudctl\" ]"; then ok "Skrip server terpasang (~/$REMOTE_DIR)"
  else fail "Skrip server belum terpasang. Jalankan: cloud deploy"; bad=1; fi

  if [ "$bad" = 0 ]; then
    while IFS= read -r line; do
      case "$line" in
        sshd*|watchdog*|Internet*|Perangkat*|Storage*) note "$line" ;;
      esac
    done < <(rc status 2>/dev/null || true)
  fi

  if remote_sh "[ -d \"\$HOME/$REMOTE_ROOT\" ]"; then ok "Folder cloud ada (~/$REMOTE_ROOT)"
  else fail "Folder cloud ~/$REMOTE_ROOT belum ada. Jalankan: cloud setup"; bad=1; fi

  if use_rsync; then ok "rsync tersedia di kedua HP (transfer bisa dilanjutkan)"
  else note "rsync tidak ada di salah satu HP, transfer memakai scp (tidak bisa dilanjutkan)"; fi

  if have termux-notification; then ok "Notifikasi tersedia (untuk monitor)"
  else note "termux-notification tidak ada. Monitor hanya menulis ke log"; fi

  local pidf="$RUN_DIR/monitor.pid"
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then ok "Monitor berjalan (PID $(cat "$pidf"))"
  else note "Monitor tidak berjalan. Nyalakan: cloud monitor --bg"; fi

  [ "$bad" = 0 ] && echo "Semua pemeriksaan utama lolos." || { echo "Ada yang perlu diperbaiki (lihat [GAGAL])."; return 1; }
}

# ---------- monitor: notifikasi Android bila HP cloud mati ----------
notify() { # notify <judul> <isi>
  echo "$(date '+%F %T') $1: $2"
  if have termux-notification; then
    termux-notification --id cloud-status --title "$1" --content "$2" --priority high 2>/dev/null || true
  fi
}

probe_up() {
  local h
  for h in "$CLOUD_HOST" "$CLOUD_HOST_ALT"; do
    if [ -n "$h" ] && tcp_ok "$h" "$SSH_PORT"; then return 0; fi
  done
  return 1
}

monitor_loop() {
  local interval="$1" state="" now
  have termux-wake-lock && termux-wake-lock || true
  while true; do
    if probe_up; then now=up; else now=down; fi
    if [ "$now" != "$state" ]; then
      case "$now" in
        up)   [ -n "$state" ] && notify "HP cloud kembali online" "SSH menjawab lagi." ;;
        down) notify "HP cloud tidak terjangkau" "Mati, offline, sshd berhenti, atau IP berubah." ;;
      esac
      state="$now"
    fi
    sleep "$interval"
  done
}

cmd_monitor() {
  local pidf="$RUN_DIR/monitor.pid" logf="$RUN_DIR/monitor.log" interval=60
  mkdir -p "$RUN_DIR"
  case "${1:-}" in
    --stop)
      if [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null; then echo "Monitor dihentikan."; else echo "Monitor tidak berjalan."; fi
      rm -f "$pidf"; return ;;
    --bg)
      if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then echo "Monitor sudah berjalan (PID $(cat "$pidf"))."; return; fi
      nohup bash "$SELF" monitor "${2:-60}" >> "$logf" 2>&1 < /dev/null &
      echo $! > "$pidf"
      echo "Monitor berjalan di latar belakang (PID $!). Log: $logf"; return ;;
    [0-9]*) interval="$1" ;;
  esac
  echo "Memantau HP cloud tiap ${interval} dtk. Berhenti dengan Ctrl+C."
  monitor_loop "$interval"
}

cmd_help() {
  cat <<'H'
cloud (admin) - kendalikan HP cloud dari HP admin

Pertama kali:
  init [ip user [port]]  pasang kunci SSH & simpan konfigurasi (tanpa argumen = interaktif)
  setup                  kirim skrip ke HP cloud + jalankan install di sana (perbaikan/ulang)

Mengatur HP cloud:
  start | restart | status
  stop                   hentikan sshd + watchdog (minta konfirmasi)
  logs [-f]              log watchdog
  boot-install           pasang auto-start di HP cloud
  ssh-harden             matikan login password SSH (minta konfirmasi)
  config                 edit config/server.env di HP cloud
  deploy                 kirim ulang skrip server/
  upgrade                git pull repo ini lalu deploy
  shell                  SSH interaktif ke HP cloud

File di cloud:
  ls [folder]            isi folder
  mkdir <folder>         buat folder
  push <lokal> [folder]  kirim ke cloud
  pull <path> [lokal]    ambil dari cloud (default: Downloads)
  rm <path>...           hapus permanen (minta konfirmasi)

Lain-lain:
  doctor                 diagnosa koneksi & pengaturan, langkah demi langkah
  info                   detail koneksi untuk aplikasi SFTP lain
  set <KUNCI> <nilai>    ubah CLOUD_HOST, CLOUD_HOST_ALT, CLOUD_USER, SSH_PORT
  monitor [dtk]          pantau HP cloud, notifikasi jika mati
  monitor --bg [dtk]     di latar belakang  |  monitor --stop

Opsi: -y / --yes melewati pertanyaan konfirmasi.
H
}

main() {
  local a ARGS=()
  for a in "$@"; do
    case "$a" in -y|--yes) ASSUME_YES=1 ;; *) ARGS+=("$a") ;; esac
  done
  set -- ${ARGS[@]+"${ARGS[@]}"}

  local c="${1:-help}"; [ $# -gt 0 ] && shift
  case "$c" in
    help|-h|--help) cmd_help; return ;;
    init)           cmd_init "$@"; return ;;
    doctor)         cmd_doctor; return ;;
  esac
  load_conf
  case "$c" in
    set)      cmd_set "$@" ;;
    info)     cmd_info ;;
    monitor)  cmd_monitor "$@" ;;
    *)
      connect
      case "$c" in
        deploy)   cmd_deploy ;;
        upgrade)  cmd_upgrade ;;
        setup)    cmd_deploy; rc_tty install --yes ;;
        status)   rc status ;;
        logs)     case " $* " in *" -f "*) rc_tty logs "$@" ;; *) rc logs "$@" ;; esac ;;
        stop)     cmd_stop ;;
        ssh-harden) cmd_harden ;;
        start|restart|boot-install) rc "$c" ;;
        config)   ssh -t "${COMMON[@]}" -p "$SSH_PORT" "$TARGET" "nano \"\$HOME/$REMOTE_DIR/config/server.env\"" ;;
        shell)    ssh -t "${COMMON[@]}" -p "$SSH_PORT" "$TARGET" ;;
        ls)       cmd_ls "$@" ;;
        mkdir)    cmd_mkdir "$@" ;;
        rm)       cmd_rm "$@" ;;
        pull)     cmd_pull "$@" ;;
        push)     cmd_push "$@" ;;
        *)        cmd_help; exit 1 ;;
      esac ;;
  esac
}
main "$@"; exit
