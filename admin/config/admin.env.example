# Disalin otomatis oleh `./admin/cloudctl init` menjadi config/admin.env

# IP LAN atau IP Tailscale (100.x.y.z) / nama MagicDNS HP server
CLOUD_HOST=192.168.1.50

# Username Termux di HP (cek dengan `whoami` di Termux, mis. u0_a123)
CLOUD_USER=u0_a123

SSH_PORT=8022
SSH_KEY="$HOME/.ssh/id_ed25519_cloud"

# Folder proyek di HP, relatif terhadap $HOME Termux
REMOTE_DIR=android-storage-cloud

# Folder cloud di HP (relatif terhadap $HOME Termux), dipakai perintah push/pull
REMOTE_ROOT=storage/shared/CloudStorage

# Port web Filebrowser
FB_PORT=8080
